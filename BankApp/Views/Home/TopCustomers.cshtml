@model BankApp.ViewModels.CountryTopCustomersViewModel
@{
    ViewData["Title"] = $"Topp 10 - {Model.Country}";
}

<div class="statistics-page">

    <div class="row justify-content-center mb-4">
        <div class="col-lg-8 text-center text-white">
            <h1 class="display-5 fw-bold mb-2">Topp 10 i @Model.Country</h1>
            <p class="lead text-white-50 mb-3">Kunder med högst totalt saldo</p>
            <div class="mx-auto" style="width:60px; height:3px; background:var(--tblr-primary); border-radius:2px;"></div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover table-vcenter card-table">
                        <thead>
                            <tr>
                                <th style="width:60px;">#</th>
                                <th style="width:140px;">Kundnummer</th>
                                <th>Namn</th>
                                <th class="text-end">Totalt saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var rank = 1; }
                            @foreach (var c in Model.Customers)
                            {
                                <tr>
                                    <td class="text-muted">@rank</td>
                                    <td class="text-muted">@c.CustomerId</td>
                                    <td>
                                        @if (User.IsInRole("Cashier"))
                                        {
                                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@c.CustomerId">
                                                @c.Givenname @c.Surname
                                            </a>
                                        }
                                        else
                                        {
                                            @c.Givenname @c.Surname
                                        }
                                    </td>
                                    <td class="text-end">@c.TotalBalance.ToString("N2") kr</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <p class="mt-3 text-center">
                <a asp-action="Index" class="btn btn-outline-light">← Tillbaka till startsidan</a>
            </p>
        </div>
    </div>

</div>