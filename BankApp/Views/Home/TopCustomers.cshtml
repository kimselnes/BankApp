@model BankApp.ViewModels.CountryTopCustomersViewModel
@{
    ViewData["Title"] = $"Topp 10 - {Model.Country}";
}

<h2 class="mb-1">Topp 10 kunder i @Model.Country</h2>
<div class="text-muted mb-3">Högst totalt saldo</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kundnummer</th>
                    <th>Namn</th>
                    <th class="text-end">Totalt saldo</th>
                </tr>
            </thead>
            <tbody>
                @{ var rank = 1; }
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td class="text-muted">@rank</td>
                        <td class="text-muted">@c.CustomerId</td>
                        <td>
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@c.CustomerId">
                                @c.Givenname @c.Surname
                            </a>
                        </td>
                        <td class="text-end">@c.TotalBalance.ToString("N2") kr</td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
</div>

<p class="mt-3">
    <a asp-action="Index" class="btn btn-link">← Tillbaka till startsidan</a>
</p>