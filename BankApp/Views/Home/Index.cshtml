@model BankApp.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Statistik per land";
}

<div class="statistics-page">

    <div class="row justify-content-center mb-6 mt-6">
        <div class="col-lg-8 text-center text-white">
            <p class="text-uppercase text-white-50 letter-spacing mb-2" style="font-size:.75rem;">
                Systementor · Individuell uppgift
            </p>
            <h1 class="display-5 fw-bold mb-2">BankApp</h1>
            <p class="lead text-white-50 mb-3">
                Administrationssystem — statistik, kunder och konton
            </p>
            <div class="mx-auto" style="width:60px; height:3px; background:var(--tblr-primary); border-radius:2px;"></div>
        </div>
    </div>

    <div class="row row-deck row-cards mt-6">
        @foreach (var row in Model.Statistics)
        {
            var flagClass = row.Country switch
            {
                "Sweden"  => "flag-country-se",
                "Denmark" => "flag-country-dk",
                "Norway"  => "flag-country-no",
                "Finland" => "flag-country-fi",
                _         => ""
            };

            <div class="col-sm-6 col-lg-3">
                <a class="card card-link" asp-action="TopCustomers" asp-route-country="@row.Country">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <span class="flag @flagClass me-2"></span>
                            <div class="h3 mb-0">@row.Country</div>
                        </div>

                        <div class="row">
                            <div class="col">
                                <div class="text-muted small">Kunder</div>
                                <div class="h2 mb-0">@row.CustomerCount</div>
                            </div>
                            <div class="col">
                                <div class="text-muted small">Konton</div>
                                <div class="h2 mb-0">@row.AccountCount</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="text-muted small">Totalt saldo</div>
                        <div class="h3 mb-0">@row.TotalBalance.ToString("N2") kr</div>
                    </div>
                </a>
            </div>
        }
    </div>

</div>
