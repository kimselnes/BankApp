@model BankApp.ViewModels.AccountDetailsViewModel
@{
    ViewData["Title"] = $"Konto {Model.Account.AccountId}";
}

<h1>Konto @Model.Account.AccountId</h1>

<p>Saldo: @Model.Account.Balance.ToString("N2") kr</p>
<p>Kontotyp: @Model.Account.Frequency — skapat @Model.Account.Created.ToString("yyyy-MM-dd")</p>

<p>
    Tillhör:
    @foreach (var owner in Model.Account.Owners)
    {
        <a class="btn btn-info" asp-controller="Customers" asp-action="Details"
           asp-route-id="@owner.CustomerId">@owner.Givenname @owner.Surname</a>
    }
</p>

<p>
    <a asp-action="Withdraw" asp-route-id="@Model.Account.AccountId" class="btn btn-warning">Ta ut</a>
    <a asp-action="Deposit" asp-route-id="@Model.Account.AccountId" class="btn btn-success">Sätt in</a>
    <a asp-action="Transfer" asp-route-id="@Model.Account.AccountId" class="btn btn-info">Överför</a>
</p>

<table class="table" id="transactionTable">
    <thead>
        <tr>
            <th>Datum</th>
            <th>Typ</th>
            <th>Operation</th>
            <th>Belopp</th>
            <th>Saldo efter</th>
            <th>Symbol</th>
            <th>Bank</th>
            <th>Konto</th>
        </tr>
    </thead>
    <tbody id="transactionBody" data-account-id="@Model.Account.AccountId">
        <partial name="_TransactionRows" model="Model.Transactions.Items" /> @*Partial*@      
    </tbody>
</table>

@if (Model.Transactions.HasNext)
{
    <button type="button" id="showMoreBtn"
            data-account-id="@Model.Account.AccountId"
            data-page-no="@(Model.Transactions.PageNo + 1)">
        Visa fler
    </button>
}

@section Scripts {
    <script src="~/js/accountTransactions.js" asp-append-version="true"></script>
}