@model BankApp.ViewModels.EditCustomerViewModel

@{
    ViewData["Title"] = "Ändra kund";
}

<div class="d-flex align-items-center mb-3">
    <div>
        <h2 class="mb-0">Ändra kund @Model.CustomerId</h2>
        <div class="text-muted">Kundnummer @Model.CustomerId</div>
    </div>
    <div class="ms-auto">
        <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-link">Avbryt</a>
    </div>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form method="post" asp-action="Edit">

    <input type="hidden" asp-for="CustomerId" />

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Personuppgifter</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Givenname" class="form-label"></label>
                    <input asp-for="Givenname" class="form-control" />
                    <span asp-validation-for="Givenname" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Surname" class="form-label"></label>
                    <input asp-for="Surname" class="form-control" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" asp-items="@Model.GenderOptions" class="form-select">
                        <option value="">-- Välj kön --</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NationalId" class="form-label"></label>
                    <input asp-for="NationalId" class="form-control" />
                    <span asp-validation-for="NationalId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Birthday" class="form-label"></label>
                    <input asp-for="Birthday" class="form-control" />
                    <span asp-validation-for="Birthday" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Adress</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Streetaddress" class="form-label"></label>
                    <input asp-for="Streetaddress" class="form-control" />
                    <span asp-validation-for="Streetaddress" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Zipcode" class="form-label"></label>
                    <input asp-for="Zipcode" class="form-control" />
                    <span asp-validation-for="Zipcode" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Country" class="form-label"></label>
                    <select asp-for="Country" asp-items="@Model.CountryOptions" class="form-select">
                        <option value="">-- Välj land --</option>
                    </select>
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Kontakt</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Telephonenumber" class="form-label"></label>
                    <input asp-for="Telephonenumber" class="form-control" />
                    <span asp-validation-for="Telephonenumber" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Emailaddress" class="form-label"></label>
                    <input asp-for="Emailaddress" class="form-control" />
                    <span asp-validation-for="Emailaddress" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="btn-list">
                <button type="submit" class="btn btn-primary">Spara ändringar</button>
                <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-link">Avbryt</a>
            </div>
        </div>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
