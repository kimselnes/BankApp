@model BankApp.ViewModels.CustomerIndexViewModel
@using BankApp.Data.Models

@{
    ViewData["Title"] = "Kunder";
}

<h1>Kunder</h1>

<form asp-action="Index" method="get">
    <input type="hidden" asp-for="SortColumn" />
    <input type="hidden" asp-for="SortOrder" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Sök</button>
    <a asp-action="Index" class="btn btn-secondary">Rensa</a>
</form>

<p>@Model.Results.TotalCount kunder</p>

<table class="table">

    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortColumn="CustomerId"
                   asp-route-sortOrder="@(Model.SortColumn == "CustomerId" && Model.SortOrder == "asc" ? "desc" : "asc")"
                   asp-route-name="@Model.Name"
                   asp-route-city="@Model.City"
                   asp-route-pageNo="1">
                    Kundnummer
                    @(Model.SortColumn == "CustomerId" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortColumn="NationalId"
                   asp-route-sortOrder="@(Model.SortColumn == "NationalId" && Model.SortOrder == "asc" ? "desc" : "asc")"
                   asp-route-name="@Model.Name"
                   asp-route-city="@Model.City"
                   asp-route-pageNo="1">
                    Personnummer
                    @(Model.SortColumn == "NationalId" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortColumn="Surname"
                   asp-route-sortOrder="@(Model.SortColumn == "Surname" && Model.SortOrder == "asc" ? "desc" : "asc")"
                   asp-route-name="@Model.Name"
                   asp-route-city="@Model.City"
                   asp-route-pageNo="1">
                    Namn
                    @(Model.SortColumn == "Surname" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortColumn="Streetaddress"
                   asp-route-sortOrder="@(Model.SortColumn == "Streetaddress" && Model.SortOrder == "asc" ? "desc" : "asc")"
                   asp-route-name="@Model.Name"
                   asp-route-city="@Model.City"
                   asp-route-pageNo="1">
                    Adress
                    @(Model.SortColumn == "Streetaddress" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortColumn="City"
                   asp-route-sortOrder="@(Model.SortColumn == "City" && Model.SortOrder == "asc" ? "desc" : "asc")"
                   asp-route-name="@Model.Name"
                   asp-route-city="@Model.City"
                   asp-route-pageNo="1">
                    Stad
                    @(Model.SortColumn == "City" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model.Results.Items)
        {
            <tr>
                <td>@c.CustomerId</td>
                <td>@c.NationalId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@c.CustomerId">
                        @c.Givenname @c.Surname
                    </a>
                </td>
                <td>@c.Streetaddress</td>
                <td>@c.City</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Results.PageCount > 1)
{
    var pageNo = Model.Results.PageNo;
    var pageCount = Model.Results.PageCount;
    int window = 2;

    var start = Math.Max(2, pageNo - window);
    var end = Math.Min(pageCount - 1, pageNo + window);

    <nav>
        @if (pageNo > 1)
        {
            <a class="btn btn-secondary"
               asp-action="Index"
               asp-route-name="@Model.Name"
               asp-route-city="@Model.City"
               asp-route-sortColumn="@Model.SortColumn"
               asp-route-sortOrder="@Model.SortOrder"
               asp-route-pageNo="@(pageNo - 1)">Föregående</a>
        }

        <a class="btn @(pageNo == 1 ? "btn-primary" : "btn-secondary")"
           asp-action="Index"
           asp-route-name="@Model.Name"
           asp-route-city="@Model.City"
           asp-route-sortColumn="@Model.SortColumn"
           asp-route-sortOrder="@Model.SortOrder"
           asp-route-pageNo="1">1</a>

        @if (start > 2)
        {
            <span>…</span>
        }

        @for (int i = start; i <= end; i++)
        {
            <a class="btn @(pageNo == i ? "btn-primary" : "btn-secondary")"
               asp-action="Index"
               asp-route-name="@Model.Name"
               asp-route-city="@Model.City"
               asp-route-sortColumn="@Model.SortColumn"
               asp-route-sortOrder="@Model.SortOrder"
               asp-route-pageNo="@i">@i</a>
        }

        @if (end < pageCount - 1)
        {
            <span>…</span>
        }

        <a class="btn @(pageNo == pageCount ? "btn-primary" : "btn-secondary")"
           asp-action="Index"
           asp-route-name="@Model.Name"
           asp-route-city="@Model.City"
           asp-route-sortColumn="@Model.SortColumn"
           asp-route-sortOrder="@Model.SortOrder"
           asp-route-pageNo="@pageCount">@pageCount</a>

        @if (pageNo < pageCount)
        {
            <a class="btn btn-secondary"
               asp-action="Index"
               asp-route-name="@Model.Name"
               asp-route-city="@Model.City"
               asp-route-sortColumn="@Model.SortColumn"
               asp-route-sortOrder="@Model.SortOrder"
               asp-route-pageNo="@(pageNo + 1)">Nästa</a>
        }
    </nav>
}