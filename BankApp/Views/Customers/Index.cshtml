@{
    ViewData["Title"] = "Kunder";
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<h1>Kunder</h1>

<h2 class="h5 mt-4">Visa kund via kundnummer</h2>
<form asp-action="Details" method="get" class="row g-2">
    <div class="col-auto">
        <input type="number" name="id" min="1" class="form-control"
               placeholder="Kundnummer" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Visa kundbild</button>
    </div>
</form>
