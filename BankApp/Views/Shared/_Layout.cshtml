<!DOCTYPE html>
<html lang="sv" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BankApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BankApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bankapp.css" asp-append-version="true" />
</head>
<body>
    <div class="page">

        <header class="navbar navbar-expand-md d-print-none border-bottom">
            <div class="container-xl">

                <a class="navbar-brand navbar-brand-autodark me-3" asp-controller="Home" asp-action="Index">
                    BankApp
                </a>

                <ul class="navbar-nav flex-row order-md-middle">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Statistik</a>
                    </li>

                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customers" asp-action="Index">Kunder</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customers" asp-action="Create">Skapa kund</a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Index">Användare</a>
                        </li>
                    }
                </ul>

                <div class="ms-auto">
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </header>

        <div class="page-wrapper flex-fill">
            <div class="page-body">
                <div class="container-xl pt-3">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Stäng"></button>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Stäng"></button>
                        </div>
                    }

                    @RenderBody()

                </div>
            </div>
        </div>

            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl text-center text-muted">
                    &copy; 2026 - BankApp - <a href="[github.com](https://github.com/kimselnes)">Kim Selnes</a>
                </div>
            </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tabler.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
