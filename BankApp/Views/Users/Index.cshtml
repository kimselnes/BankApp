@model BankApp.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "Användare";
}

<div class="d-flex align-items-center mb-3">
    <div>
        <h2 class="mb-0">Systemanvändare</h2>
        <div class="text-muted">@Model.Users.Count användare</div>
    </div>
    <div class="ms-auto">
        <a asp-action="Create" class="btn btn-primary">Ny användare</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-vcenter card-table">
            <thead>
                <tr>
                    <th>E-post</th>
                    <th>Roller</th>
                    <th style="width: 180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>
                            @if (user.Roles.Count == 0)
                            {
                                <span class="badge bg-red-lt">Ingen roll</span>
                            }
                            else
                            {
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-blue-lt">@role</span>
                                }
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Ändra</a>
                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Ta bort</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
