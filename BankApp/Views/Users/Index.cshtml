@{
    ViewData["Title"] = "Användare";
}

<h1>Systemanvändare</h1>

<p class="text-muted">Hantering av systemanvändare och roller.</p>

<table class="table">

    <thead>
        <tr>
            <th>E-post</th>
            <th>Roller</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Email</td>
                <td>@(user.Roles.Count > 0 ? string.Join(", ", user.Roles) : "Ingen roll")</td>
                <td>
					<a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Ändra</a>
					<a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Ta bort</a>
                </td>
            </tr>
        }

    </tbody>

</table>