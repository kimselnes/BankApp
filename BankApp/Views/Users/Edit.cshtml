@model BankApp.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Ändra användare";
}


<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="row justify-content-center">
    <div class="col-lg-6">

        <div class="d-flex align-items-center mb-3">
            <div>
                <h2 class="mb-0">Ändra användare</h2>
                <div class="text-muted">@Model.Email</div>
            </div>
            <div class="ms-auto">
                <a asp-action="Index" class="btn btn-link">Avbryt</a>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="post" asp-action="Edit">

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <div class="text-muted small">E-post</div>
                        <div>@Model.Email</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" asp-items="@Model.RoleOptions" class="form-select">
                            <option value="">-- Välj roll --</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="btn-list">
                        <button type="submit" class="btn btn-primary">Spara ändringar</button>
                        <a asp-action="Index" class="btn btn-link">Avbryt</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
